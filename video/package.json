{
  "name": "gstar-demo-video",
  "private": true,
  "description": "Remotion source for the G-STAR demo video",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render GSTARDemo out/demo.mp4 --codec=h264 --crf=20",
    "poster": "remotion still GSTARDemo out/demo-poster.jpg --frame=500 --image-format=jpeg --jpeg-quality=88",
    "vtt": "node scripts/make-vtt.mjs > out/demo.vtt",
    "build": "npm run render && npm run poster && npm run vtt"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
